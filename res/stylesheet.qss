#m_pMainWidget {
	background-image:url("res/motherboard.svg"); background-position: center;
	background-color: rgb(100,100,100);
}

#m_pGameFrame, #m_pInfoFrame, #m_pObjectsFrame, #m_pMessagesFrame {
	border-top: 5px outset rgb(70,70,70);
	border-left: 5px outset rgb(70,70,70);
	border-right: 5px outset rgb(55,55,55);
	border-bottom: 5px outset rgb(55,55,55);
}

#m_pInfoFrame {
	background-color: rgb(236,236,236);
}

QLCDNumber {
	background-color: black;
	color: white;
}

QTableView, QHeaderView, #m_pLblFind, #m_pBackButton, #m_pGoButton {
	font-size: 18px;
}

QTableView, QHeaderView {
	font-weight: bold;
}

#m_pLblFind {
	font-weight: bold;
	color: white;
}

#m_pControlsFrame {
	border-radius: 8px;
	background-color: rgba(255,255,255,0.5);
	color: black;
	margin-bottom: 10px;
	margin-right: 25px;
	margin-left: 25px;

}

#m_pBtnPlay {
	background-color: rgba(0,0,0,0);
	border: 0;
	margin: 0;
	padding: 0
}

#m_pSldSpeed::handle {
    image: url("res/ffrw.svg");
    width: 34px;
    margin: -10px 0px -10px 0px;
}

#m_pSldSpeed::groove {
	background: rgb(184,184,184);
	height: 0px;
}

#m_pSldSeek::add-page::groove {
	background: red;
}

#m_pSldSeek::sub-page::groove {
	background: green;
}

#m_pTextBrowser {
	color: black;
}

#m_pPrgVolFrame {
	border-radius: 8px;
	background-color: rgba(255,255,255,0.5);
	margin-left: 20px;
	margin-right: 20px;
	color: black;
}

QRadioButton {
	font-size: 24px;
	border: 4px dotted black;
	border-radius: 12px;
	padding: 8px;
}

QRadioButton::checked {
    color: black;
    background: white;
}

QRadioButton::unchecked {
    color: white;
}

QRadioButton::indicator {
    width: 8px;
    height: 8px;
    border-style: solid;
    border-radius: 12px;
	border-width: 8px;
	margin-right: 16px;
}

QRadioButton::indicator::unchecked {
    background: #eaeaea;
    color: #eaeaea;
}

QRadioButton::indicator::unchecked::hover {
    background: #cccccc;
    color: #cccccc;
}

QRadioButton::indicator::checked {
    background: white;
    color: #1E81F0;
}
